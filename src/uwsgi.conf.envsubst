[uwsgi]
# https://www.bloomberg.com/company/stories/configuring-uwsgi-production-deployment/
strict = true
master = true
enable-threads = true
chdir = ${MAPPROXY_BASE_DIR}
wsgi-file = ${MAPPROXY_BASE_DIR}/app.py
socket = 0.0.0.0:8000

single-interpreter = true
die-on-term = true
need-app = true

disable-logging = true
log-4xx = true
log-5xx = true

harakiri = 60                        ; forcefully kill workers after 60 seconds
post-buffering = 65536               ; read request bodies before passing them to workers (larger ones go to a temp file)
# py-callos-afterfork = true           ; allow workers to trap signals

auto-procname = true
procname-prefix = (mapproxy) 

max-requests = 5000                  ; Restart workers after this many requests
max-worker-lifetime = 3600           ; Restart workers after this many seconds
reload-on-rss = 256                  ; Restart workers after this much resident memory (MB)
worker-reload-mercy = 60

# defaults sized for a container with 2 CPUs and 4 GB of memory:
# 16 workers x 256 MB (reload-on-rss) + master (~140 MB) stays below 4 GB
cheaper-algo = busyness
processes = 16                       ; Maximum number of workers allowed
cheaper = 2                          ; Minimum number of workers allowed
cheaper-initial = 4                  ; Workers created at startup
cheaper-overload = 1                 ; Length of a cycle in seconds
cheaper-step = 2                     ; How many workers to spawn at a time
memory-report = true                 ; Required by cheaper-rss-limit-soft
cheaper-rss-limit-soft = 2684354560  ; Don't spawn workers if their total RSS exceeds 2.5 GB (bytes)

cheaper-busyness-multiplier = 30     ; How many cycles to wait before killing workers
cheaper-busyness-min = 20            ; Below this threshold, kill workers (if stable for multiplier cycles)
cheaper-busyness-max = 70            ; Above this threshold, spawn new workers
cheaper-busyness-backlog-alert = 16  ; Spawn emergency workers if more than this many requests are waiting in the queue
cheaper-busyness-backlog-step = 2    ; How many emergency workers to create if there are too many requests in the queue
